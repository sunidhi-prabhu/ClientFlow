// ClientFlow database schema.
// The connection URL lives in prisma.config.ts, not here (Prisma 7+).
//
// Tenancy rules (see docs/architecture.md §4 and src/server/tenancy/):
// - Every tenant-owned model has a required `organizationId` and
//   `@@unique([organizationId, id])`, so children can reference it with a
//   composite foreign key. That unique index also serves as the
//   organization-leading index for tenant-wide queries.
// - A child references a tenant-owned parent with BOTH columns:
//   `fields: [organizationId, parentId], references: [organizationId, id]`.
//   PostgreSQL then rejects any link between rows of different organizations.
// - Every new model must be classified in src/server/tenancy/models.ts.
//
// Client and Project are intentionally minimal: they establish the tenancy
// structure only. Feature milestones add their remaining fields.
//
// User, Session, Account and Verification are GLOBAL authentication models
// owned by Better Auth (field names must match its schema). They are never
// reachable through the tenant-scoped client.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// The tenant. Root of every tenant-owned record.
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Last invoice number issued in this organization (incremented atomically on issue).
  invoiceSequence Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships       Membership[]
  clients           Client[]
  clientActivities  ClientActivity[]
  projects          Project[]
  projectMembers    ProjectMember[]
  projectActivities ProjectActivity[]
  tasks             Task[]
  invoices          Invoice[]
  invoiceItems      InvoiceItem[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Tenant-owned: a user's role in one organization. A user may belong to many
/// organizations. The database guarantees every organization keeps at least
/// one OWNER (see the init_auth migration trigger).
model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectMembers ProjectMember[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId])
  // Deliberate exception to "indexes lead with organizationId": resolving the
  // organizations a signed-in user belongs to is a per-user lookup.
  @@index([userId])
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

/// Tenant-owned: a customer of the organization.
model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  company        String?
  email          String?
  phone          String?
  /// Free-form postal address (multi-line).
  address        String?
  notes          String?
  /// ARCHIVED is set only by the archive operation (archivedAt records when).
  status         ClientStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  activities   ClientActivity[]
  invoices     Invoice[]

  @@unique([organizationId, id])
  // Default list: an organization's clients by status, ordered by name / recency.
  @@index([organizationId, status, name])
  @@index([organizationId, updatedAt])
}

enum ClientActivityType {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

/// Tenant-owned, append-only history of changes to one client. Written in the
/// same transaction as the change it records.
model ClientActivity {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  /// Who made the change; null if that user was later deleted.
  actorUserId    String?
  type           ClientActivityType
  /// For UPDATED: { field: { from, to } } for each changed field.
  changes        Json?
  createdAt      DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, clientId, createdAt])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

/// Declaration order is the sort order (LOW < … < URGENT).
enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Tenant-owned; optionally for one client of the same organization.
/// CHECK constraints (migration project_management): progress is 0-100 and
/// dueDate is not before startDate.
model Project {
  id                  String          @id @default(cuid())
  organizationId      String
  clientId            String?
  name                String
  description         String?
  /// ARCHIVED is set only by the archive operation.
  status              ProjectStatus   @default(PLANNING)
  /// The status to return to when an archived project is restored.
  statusBeforeArchive ProjectStatus?
  priority            ProjectPriority @default(MEDIUM)
  startDate           DateTime?       @db.Date
  dueDate             DateTime?       @db.Date
  /// Percent complete, 0-100.
  progress            Int             @default(0)
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: a client, if set, must belong to the same organization.
  // (MATCH SIMPLE: a NULL clientId means "no client" and is not checked.)
  client       Client?           @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: NoAction)
  members      ProjectMember[]
  activities   ProjectActivity[]
  tasks        Task[]

  @@unique([organizationId, id])
  @@index([organizationId, clientId])
  // Default list: an organization's projects by status, ordered by name / recency.
  @@index([organizationId, status, name])
  @@index([organizationId, updatedAt])
}

/// Tenant-owned: a person working on a project. References the organization
/// Membership by (organizationId, userId), so PostgreSQL guarantees that every
/// project member belongs to the project's organization; leaving the
/// organization removes the person from its projects.
model ProjectMember {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  membership    Membership   @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  assignedTasks Task[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, userId])
  @@index([organizationId, userId])
}

enum ProjectActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ARCHIVED
  RESTORED
  MEMBER_ADDED
  MEMBER_REMOVED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNMENT_CHANGED
  TASK_DELETED
}

/// Tenant-owned, append-only history of one project (same pattern as
/// ClientActivity). Written in the same transaction as the change.
model ProjectActivity {
  id             String              @id @default(cuid())
  organizationId String
  projectId      String
  /// Who made the change; null if that user was later deleted.
  actorUserId    String?
  /// Set for TASK_* events. Deliberately not a foreign key, so a task's
  /// history (including TASK_DELETED) outlives the task.
  taskId         String?
  type           ProjectActivityType
  /// UPDATED / STATUS_CHANGED: { field: { from, to } }.
  /// MEMBER_*: { member: { userId, name } } (name captured at the time).
  changes        Json?
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, taskId, createdAt])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

/// Declaration order is the sort order (LOW < … < URGENT).
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Tenant-owned; belongs to exactly one project of the same organization and
/// may be assigned to one member of that project.
/// Trigger (migration task_management): removing someone from a project (or
/// the organization) unassigns their tasks there.
model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @db.Date
  /// A member of this task's project (NULL = unassigned).
  assigneeUserId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: the project must be in the same organization.
  project      Project        @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  // Composite FK: the assignee must be a member of this exact project.
  // (MATCH SIMPLE: a NULL assignee is not checked.)
  assignee     ProjectMember? @relation(fields: [organizationId, projectId, assigneeUserId], references: [organizationId, projectId, userId], onDelete: NoAction)

  @@unique([organizationId, id])
  // Kanban board: a project's tasks by column.
  @@index([organizationId, projectId, status])
  // Assignee FK lookups (e.g. when a project member is removed).
  @@index([organizationId, projectId, assigneeUserId])
}

// ---------------------------------------------------------------------------
// Global authentication models (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  memberships       Membership[]
  clientActivities  ClientActivity[]
  projectActivities ProjectActivity[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  /// Opaque session token (the cookie holds a signed copy).
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Credentials (providerId "credential", scrypt password hash) and OAuth
/// accounts (e.g. providerId "google").
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Server-side single-use tokens: email verification codes and password reset
/// tokens. Identifiers and codes are stored hashed.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Persisted invoice states. OVERDUE is derived (ISSUED and past its due
/// date) rather than stored, so it can never be stale; see docs/architecture.md.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

/// Tenant-owned invoice for one client of the same organization.
/// Money is integer minor units (cents) in `currency`; rates are basis points.
/// CHECK constraints and triggers (migration invoice_management) enforce total
/// consistency and make everything except payment/cancellation immutable once
/// the invoice is no longer a draft.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  /// Sequential per organization, assigned on issue (drafts have none).
  number         Int?
  status         InvoiceStatus @default(DRAFT)
  /// ISO 4217 code of a 2-decimal currency.
  currency       String        @default("USD")
  issueDate      DateTime?     @db.Date
  dueDate        DateTime?     @db.Date
  notes          String?
  /// Invoice-level rates in basis points (1825 = 18.25%).
  discountBps    Int           @default(0)
  taxBps         Int           @default(0)
  /// Computed on the server from the items: total = subtotal - discount + tax.
  subtotalCents  Int           @default(0)
  discountCents  Int           @default(0)
  taxCents       Int           @default(0)
  totalCents     Int           @default(0)
  issuedAt       DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Composite FK: the client must belong to the same organization.
  client       Client        @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: NoAction)
  items        InvoiceItem[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  // Invoice list: by status and due date (also serves the derived OVERDUE filter).
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId])
  @@index([organizationId, createdAt])
}

/// Tenant-owned line item of an invoice (same organization, composite FK).
model InvoiceItem {
  id             String   @id @default(cuid())
  organizationId String
  invoiceId      String
  description    String
  /// Quantity in thousandths (1500 = 1.5).
  quantityMilli  Int
  unitPriceCents Int
  /// quantity × unit price, rounded half-up to the cent (server-computed).
  amountCents    Int
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [organizationId, invoiceId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, invoiceId, position])
}
