# Copy to `.env` for local development: cp .env.example .env
# Never commit real credentials. App variables are validated in src/lib/env.ts.

# PostgreSQL connection string. Matches docker-compose.yml defaults.
# Do not add `?schema=`: the app always uses the default `public` schema.
# Production: connect the app as the least-privilege role from
# db/runtime-role.sql (migrations run as the schema owner), and use TLS
# (`?sslmode=verify-full`), which is required for non-local databases.
DATABASE_URL="postgresql://clientflow:clientflow@localhost:5432/clientflow"

# Connection pool per server process, and bounded waits (defaults shown).
# Keep instances × DATABASE_POOL_MAX below the database's connection limit.
DATABASE_POOL_MAX="10"
DATABASE_CONNECT_TIMEOUT_MS="10000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"

# debug | info | warn | error
LOG_LEVEL="info"

# --- Authentication (Better Auth) -------------------------------------------
# Secret for signing cookies and tokens. At least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (used for cookies, OAuth redirects, email links).
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (optional; the button appears only when both are set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Client IP for rate limiting and audit records. Required in production (one
# of the two), so clients cannot forge their IP with X-Forwarded-For:
# - AUTH_CLIENT_IP_HEADER: a header your edge sets and overwrites, e.g.
#   cf-connecting-ip (Cloudflare) or x-real-ip (nginx `proxy_set_header`).
# - AUTH_TRUSTED_PROXIES: comma-separated IPs/CIDRs of your reverse proxies;
#   the client is the first untrusted address from the right of X-Forwarded-For.
AUTH_CLIENT_IP_HEADER=""
AUTH_TRUSTED_PROXIES=""

# --- Email ---------------------------------------------------------------------
# SMTP server for verification codes and password reset links.
# Local development: Mailpit from docker-compose (inbox at http://localhost:8025).
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="ClientFlow <no-reply@clientflow.local>"

# --- Billing (Stripe, optional) ---------------------------------------------------
# Leave ALL of these empty to run without paid plans (every organization is on
# Free). Set ALL of them to enable billing; a partial configuration refuses to
# start. Outside production only test-mode keys (sk_test_…) are accepted.
# Setup (products, prices, webhook): docs/operations.md, "Billing (Stripe)".
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint <BETTER_AUTH_URL>/api/billing/webhook
# (locally: printed by `stripe listen --forward-to localhost:3000/api/billing/webhook`).
STRIPE_WEBHOOK_SECRET=""
# One recurring Price per plan and interval (USD): $9/$90, $19/$190, $39/$390, $79/$790.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_PROFESSIONAL_MONTHLY=""
STRIPE_PRICE_PROFESSIONAL_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""

# Integration tests only (npm run test:integration). Not read by the app.
# The database name must end in `_test`; it is created if missing and its
# data is deleted between tests.
TEST_DATABASE_URL="postgresql://clientflow:clientflow@localhost:5432/clientflow_test"
